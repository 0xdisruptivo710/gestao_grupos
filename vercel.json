{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:cliente([a-z0-9][a-z0-9-]*)",
      "destination": "/:cliente/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:cliente([a-z0-9][a-z0-9-]*)/",
      "destination": "/app/index.html"
    },
    {
      "source": "/:cliente([a-z0-9][a-z0-9-]*)/:tela([a-z-]+).html",
      "destination": "/app/:tela.html"
    }
  ]
}
